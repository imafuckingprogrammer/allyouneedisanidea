# Supabase (public keys — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Points to your Railway WebSocket server
NEXT_PUBLIC_AGENT_SERVER_URL=wss://your-agent-server.railway.app

# Points to your Cloudflare Pages CDN serving embed.js
NEXT_PUBLIC_EMBED_URL=https://your-cdn.pages.dev/embed.js
